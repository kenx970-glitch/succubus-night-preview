# Local test only. Never commit secrets or paste them into chat.
HOST=127.0.0.1
PORT=3210
APP_ORIGIN=http://127.0.0.1:3210
DATABASE_PATH=./data/succubus.sqlite
# Only test Stripe keys; live keys/events are rejected.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Default: direct Google Gemini Live (separate from FAL_KEY).
VOICE_BACKEND=gemini-live
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# Local testing limits. Counts all started turns, including failed attempts.
LIVE_MAX_SESSIONS=2
LIVE_DAILY_MAX_TURNS=100
LIVE_USER_DAILY_MAX_TURNS=60
# Fal remains for media generation; legacy voice requires explicit fal-gemini selection.
# Loading/replaying pre-generated media does not trigger generation calls.
FAL_KEY=
FAL_TEXT_MODEL=google/gemini-3.8-flash
# Player price per completed response; not the provider's API cost.
VOICE_TURN_PRICE_S=5
# Rewarded video is demo-only (30 seconds / 100G). No ad revenue integration.
